{
    "name": "cairophp/laravel-octane",
    "description": "Run Laravel Octane on the Cairo application server",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "octane",
        "cairo",
        "server"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "laravel/octane": "^2.5",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Cairo\\Octane\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cairo\\Octane\\CairoOctaneServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "autoload-dev": {
        "psr-4": {
            "Cairo\\Octane\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
